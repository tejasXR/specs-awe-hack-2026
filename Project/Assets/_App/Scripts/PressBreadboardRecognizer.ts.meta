    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Pose Thresholds"}'
    - '// @input float extendedAngle = 135 {"hint":"Index bend angle (deg) ABOVE which it counts as extended. ~180 = straight. LOWER this to accept a more bent index (less strict).", "widget":"slider", "min":20, "max":180, "step":1}'
