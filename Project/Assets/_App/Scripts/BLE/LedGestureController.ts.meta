    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Left hand — brightness</span>"}'
    - '// @input float minBrightness = 0.2 {"hint":"Lowest brightness (pinch height = floor). 0.2 = 20%"}'
    - '// @input float brightnessTravelCm = 10 {"hint":"Vertical hand travel above pinch height for full brightness, in cm"}'
