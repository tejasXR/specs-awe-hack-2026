  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">LedGestureController</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Left hand = brightness, right hand = flash. Writes to BreadboardBleController.</span>"}'
