  ScriptAsset: !<reference> 2efdd206-e8d1-4aa8-a4c7-bf3142bdf39c
  ScriptInputsDefault:
    mainTrackVolume: true
    voiceDescriptions: true
  ScriptTypesDefault:
    {}
  ScriptInputs:
    "":
      musicController: !<MappingBased.AssignableType> 8df55664-959b-4d8a-91ed-cda0ab3af4bc
      mainTrack: !<reference.AudioTrackAsset> 63707584-d507-4108-9be2-f966f6354545
      mainTrackVolume: !<float> 0.000000
      breadboardOrigin: !<reference.SceneObject> d1b20632-19f8-4f71-be2a-709dc137d1f3
      onboardingController: !<MappingBased.AssignableType_1> 51ce85a7-c4d8-4ed4-bbae-062a47aeaf0f
      spaceSetup: !<MappingBased.AssignableType_2> 5a9e8d73-a99d-45b2-8ab8-ff9ddefcafd3
      menuConsole: !<MappingBased.AssignableType_3> 24ae494e-b174-48a0-8e8d-7245cff230b5
      instructionPrompt: !<MappingBased.AssignableType_4> 7e281ca4-c9d7-4453-8e28-c86df6d7c76b
      zappy: !<MappingBased.AssignableType_5> ba9b0252-db63-4aee-ba69-de0f00706d9b
      voiceDescriptions: true
      linePrefab: !<reference.ObjectPrefab> e362da3c-55d0-465a-a0c1-94ca01b562b1
      linePoolParent: !<reference.SceneObject> 0af33c18-ea34-4408-b8e0-dea027c17886
      calloutStartAnchor: !<reference.SceneObject> 0c2e4402-156a-4adf-aa3a-7664655fe73e
      hoverOffsetCm: !<float> 0.000000
      instructionDefinitions:
        - title: The breadboard
          description: |-
            The breadboard is the heart of your project.
            
            We attach things to CELLS, which are labeled by a letter and a number
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: true
          dividerKind: breadboard
          startOnRail: false
          columnStart: A
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Meet the LED
          description: |-
            Looks like an LED is already attached on the breadboard, sweet!
            
            Let's try to power it up!
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: E
          startRail: far-plus
          rowStart: !<float> 5.000000
          useEndPin: false
          endOnRail: false
          columnEnd: J
          endRail: ""
          rowEnd: !<float> 1.000000
        - title: Power Switch
          description: Press the power switch here to turn on power to the breadboard
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: true
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: A
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Power Rails
          description: |-
            Hmm, power runs through the side of the breadboard, there's no power to the LED!
            
            These blue lines indicate power
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Wires
          description: |-
            We can use a wire the route power from the power rails to the LED.
            
            Pick up a RED WIRE and press CONTINUE 
          primaryButtonText: Contnue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: true
          dividerKind: wires
          startOnRail: false
          columnStart: A
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Place Wire
          description: "Place one side of the RED WIRE on the (+) side of the power rail here, and the other side in cell [E10]."
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: true
          columnStart: A
          startRail: near-plus
          rowStart: !<float> 4.000000
          useEndPin: true
          endOnRail: false
          columnEnd: E
          endRail: ""
          rowEnd: !<float> 10.000000
        - title: Power Direction
          description: "We placed a RED WIRE near our LED, but power only moves horizontally across the breadboard, not up or down."
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Resistors
          description: We can safely re-route power on a breadboard using a RESISTOR. Pick one up and CONTINUE
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: true
          dividerKind: resistors
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Resistor
          description: "Place this RESISTOR between [C5] and [C10]"
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: C
          startRail: near-plus
          rowStart: !<float> 10.000000
          useEndPin: true
          endOnRail: false
          columnEnd: C
          endRail: ""
          rowEnd: !<float> 5.000000
        - title: Ground the Current
          description: |-
            Almost there! We need to ground the current to close the electrical loop.
            
            Pick up a BLACK WIRE and CONTINUE
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: true
          dividerKind: wires
          startOnRail: false
          columnStart: A
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Ground Wire
          description: "Place one side of the BLACK WIRE on the (-) side of the power rail here, and the other side in [A4]."
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: true
          columnStart: A
          startRail: near-minus
          rowStart: !<float> 4.000000
          useEndPin: true
          endOnRail: false
          columnEnd: A
          endRail: ""
          rowEnd: !<float> 4.000000
        - title: Check Work
          description: "Great job so far! Before moving on, let's have Zappy check your work! Just pinch Zappy!"
          primaryButtonText: Check work
          secondaryButtonText: Back
          tertiaryButtonText: Skip
          isCheckpoint: true
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Adding More Color
          description: "Let's make our breadboard more colorful. Pick up a LED and CONTINUE"
          primaryButtonText: Continue
          secondaryButtonText: ""
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: true
          dividerKind: leds
          startOnRail: false
          columnStart: A
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: LED Orientation
          description: |-
            A LED's long is it's ANODE (+). This is where a power current should flow in.
            
            The the shorter end is the CATHODE (-), where current should flow out
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: PLACE LED
          description: "Place the ANODE (+) of the LED in [F19], and the CATHODE (-) of the LED in [F20]"
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: F
          startRail: near-plus
          rowStart: !<float> 20.000000
          useEndPin: true
          endOnRail: false
          columnEnd: F
          endRail: ""
          rowEnd: !<float> 19.000000
        - title: POWER WIRE
          description: "Place one side of a RED WIRE on the (+) side of the power rail here, and the other side in [J15]"
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: true
          columnStart: A
          startRail: far-plus
          rowStart: !<float> 10.000000
          useEndPin: true
          endOnRail: false
          columnEnd: J
          endRail: ""
          rowEnd: !<float> 15.000000
        - title: Place RESISTOR
          description: "To move the current to the LED, place a RESISTOR from [H15] to [H19]"
          primaryButtonText: ""
          secondaryButtonText: ""
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: H
          startRail: near-plus
          rowStart: !<float> 15.000000
          useEndPin: true
          endOnRail: false
          columnEnd: H
          endRail: ""
          rowEnd: !<float> 19.000000
        - title: GROUND WIRE
          description: |-
            From what we learned about closing the electric loop, where should we place a BLACK WIRE?
            
            Ask Zappy if you're stuck!
          primaryButtonText: Continue
          secondaryButtonText: Back
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: CHECK WORK
          description: "Before we use the power switch, let's check our work!"
          primaryButtonText: Check Work
          secondaryButtonText: Back
          tertiaryButtonText: Skip
          isCheckpoint: true
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: FINAL LED
          description: |-
            There's a LED at [J30] that need some power!
            
            I wonder if a power cable got loose!
          primaryButtonText: ""
          secondaryButtonText: ""
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: J
          startRail: near-plus
          rowStart: !<float> 30.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: FIX POWER WIRE
          description: "Look at the power cable inserted at [J38], where should this be placed  near our LED to make it light up?"
          primaryButtonText: ""
          secondaryButtonText: ""
          tertiaryButtonText: ""
          isCheckpoint: false
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: None
          startRail: near-plus
          rowStart: !<float> 29.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
        - title: Magic LED
          description: This is no ordinary LED!  Go ahead and pinch & hold with either hand to magically control this light!
          primaryButtonText: ""
          secondaryButtonText: ""
          tertiaryButtonText: Skip
          isCheckpoint: true
          pointToPower: false
          pointToDivider: false
          dividerKind: breadboard
          startOnRail: false
          columnStart: A
          startRail: near-plus
          rowStart: !<float> 1.000000
          useEndPin: false
          endOnRail: false
          columnEnd: ""
          endRail: ""
          rowEnd: !<float> 0.000000
  ScriptTypes:
    "":
      {}
